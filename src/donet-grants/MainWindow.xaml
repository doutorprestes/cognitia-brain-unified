<Window x:Class="Grant_finder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Grant_finder"
        mc:Ignorable="d"
        Title="Buscador de Editais" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Termos de Busca:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Name="SearchTextBox" Width="300" VerticalAlignment="Center"/>
            <Button Name="SearchButton" Content="Buscar" Margin="10,0,0,0" Padding="10,2" Click="SearchButton_Click"/>

            <CheckBox Name="OnlyOpenCheckBox" Content="Buscar apenas editais abertos" IsChecked="True" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </StackPanel>
        <DataGrid Name="ResultsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Título do Edital" Binding="{Binding Title}" Width="3*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="Organização" Binding="{Binding Organization}" Width="*"/>
                <DataGridTextColumn Header="Prazo Final" Binding="{Binding Deadline}" Width="*"/>
                <DataGridTextColumn Header="Fonte de Recurso" Binding="{Binding FonteDeRecurso}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="StatusTextBlock" Text="Pronto."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>