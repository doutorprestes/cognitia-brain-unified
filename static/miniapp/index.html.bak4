<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
    <meta name="theme-color" content="#0f172a">
    <title>CognitiaBrain</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        :root {
            --bg: var(--tg-theme-bg-color, #0f172a);
            --surface: var(--tg-theme-secondary-bg-color, #1e293b);
            --surface-hover: var(--tg-theme-section-bg-color, #273548);
            --primary: var(--tg-theme-button-color, #3b82f6);
            --primary-text: var(--tg-theme-button-text-color, #ffffff);
            --text: var(--tg-theme-text-color, #f1f5f9);
            --text-muted: var(--tg-theme-hint-color, #94a3b8);
            --link: var(--tg-theme-link-color, #60a5fa);
            --destructive: #ef4444;
            --success: #22c55e;
            --border: rgba(148,163,184,0.12);
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            --radius: 12px;
            --radius-sm: 8px;
            --space: 12px;
        }
        
        html, body { height: 100%; overflow: hidden; }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg);
            color: var(--text);
            font-size: 14px;
            line-height: 1.4;
            -webkit-font-smoothing: antialiased;
        }
        
        .app {
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        /* Header */
        .header {
            flex-shrink: 0;
            padding: 12px 16px;
            padding-top: calc(12px + var(--safe-top));
            background: var(--surface);
            border-bottom: 1px solid var(--border);
        }
        
        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .header-title {
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }
        
        .header-subtitle {
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-top: 2px;
        }
        
        .header-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: var(--text-muted);
            font-size: 1.1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .header-btn:active { background: var(--surface-hover); }
        
        /* Stats */
        .stats {
            display: flex;
            gap: 8px;
            padding: 12px 16px;
            flex-shrink: 0;
        }
        
        .stat {
            flex: 1;
            background: var(--surface);
            border-radius: var(--radius-sm);
            padding: 10px 8px;
            text-align: center;
            border: 1px solid var(--border);
        }
        
        .stat-value {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--primary);
            line-height: 1;
        }
        
        .stat-label {
            font-size: 0.6rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            margin-top: 4px;
        }
        
        /* Filters */
        .filters {
            display: flex;
            gap: 6px;
            padding: 0 16px 12px;
            flex-shrink: 0;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }
        
        .filters::-webkit-scrollbar { display: none; }
        
        .chip {
            padding: 6px 12px;
            border-radius: 16px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--text-muted);
            font-size: 0.7rem;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.15s;
        }
        
        .chip.active {
            background: var(--primary);
            color: var(--primary-text);
            border-color: var(--primary);
        }
        
        /* Content */
        .content {
            flex: 1;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            padding: 0 16px;
            padding-bottom: calc(80px + var(--safe-bottom));
        }
        
        /* Cards */
        .card {
            background: var(--surface);
            border-radius: var(--radius);
            padding: 14px;
            margin-bottom: 10px;
            border: 1px solid var(--border);
            animation: cardIn 0.25s ease-out;
        }
        
        @keyframes cardIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .card-header {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 8px;
        }
        
        .card-badge {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 3px 8px;
            border-radius: 10px;
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            flex-shrink: 0;
        }
        
        .card-badge.robot { background: rgba(34,197,94,0.12); color: var(--success); }
        .card-badge.llm { background: rgba(59,130,246,0.12); color: var(--link); }
        .card-badge.agent { background: rgba(168,85,247,0.12); color: #a855f7; }
        .card-badge.alignment { background: rgba(245,158,11,0.12); color: #f59e0b; }
        .card-badge.default { background: rgba(148,163,184,0.12); color: var(--text-muted); }
        
        .card-title {
            font-size: 0.85rem;
            font-weight: 600;
            line-height: 1.35;
            flex: 1;
        }
        
        .card-meta {
            display: flex;
            gap: 10px;
            font-size: 0.65rem;
            color: var(--text-muted);
            margin-bottom: 8px;
        }
        
        .card-snippet {
            font-size: 0.75rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 10px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        .card-actions {
            display: flex;
            gap: 6px;
        }
        
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            padding: 7px 12px;
            border-radius: var(--radius-sm);
            border: none;
            font-size: 0.7rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s;
            text-decoration: none;
        }
        
        .btn:active { transform: scale(0.96); }
        
        .btn-primary {
            background: var(--primary);
            color: var(--primary-text);
        }
        
        .btn-secondary {
            background: rgba(148,163,184,0.1);
            color: var(--text);
        }
        
        .btn-icon {
            width: 32px;
            height: 32px;
            padding: 0;
            border-radius: 50%;
            font-size: 0.9rem;
        }
        
        /* Empty */
        .empty {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }
        
        .empty-icon { font-size: 2rem; margin-bottom: 8px; opacity: 0.4; }
        .empty-text { font-size: 0.8rem; }
        
        /* Skeleton */
        .skeleton {
            background: linear-gradient(90deg, var(--surface) 25%, var(--surface-hover) 50%, var(--surface) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: var(--radius);
        }
        
        @keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        
        .skeleton-card { height: 120px; margin-bottom: 10px; }
        
        /* Toast */
        .toast {
            position: fixed;
            bottom: calc(80px + var(--safe-bottom));
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--surface-hover);
            border: 1px solid var(--border);
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            z-index: 100;
            opacity: 0;
            transition: all 0.2s;
            pointer-events: none;
        }
        
        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>
    <div class="app">
        <header class="header">
            <div class="header-inner">
                <div>
                    <div class="header-title">🧠 CognitiaBrain</div>
                    <div class="header-subtitle">Monitoramento Acadêmico</div>
                </div>
                <button class="header-btn" onclick="toggleSettings()">⚙️</button>
            </div>
        </header>
        
        <div class="stats">
            <div class="stat"><div class="stat-value" id="stat-total">0</div><div class="stat-label">Total</div></div>
            <div class="stat"><div class="stat-value" id="stat-artigos">0</div><div class="stat-label">Artigos</div></div>
            <div class="stat"><div class="stat-value" id="stat-grants">0</div><div class="stat-label">Grants</div></div>
        </div>
        
        <div class="filters" id="filters">
            <div class="chip active" data-filter="all">Todos</div>
            <div class="chip" data-filter="robot">🤖 Robótica</div>
            <div class="chip" data-filter="llm">🧠 LLM</div>
            <div class="chip" data-filter="agent">🤝 Multi-Agent</div>
            <div class="chip" data-filter="alignment">⚖️ Alignment</div>
        </div>
        
        <div class="content" id="content">
            <div class="skeleton skeleton-card"></div>
            <div class="skeleton skeleton-card"></div>
            <div class="skeleton skeleton-card"></div>
        </div>
    </div>
    
    <div class="toast" id="toast"></div>
    
    <script>
        var tg = window.Telegram.WebApp;
        tg.ready();
        tg.expand();
        
        var currentFilter = 'all';
        var allItems = [];
        
        function haptic(type) {
            if (tg.HapticFeedback) tg.HapticFeedback.impactOccurred(type || 'light');
        }
        
        function api(endpoint, opts) {
            opts = opts || {};
            return fetch('/api' + endpoint, {
                headers: { 'Content-Type': 'application/json' },
                ...opts
            }).then(function(r) { return r.json(); });
        }
        
        function animateNum(el, target) {
            var start = parseInt(el.textContent) || 0;
            if (start === target) return;
            var duration = 400;
            var t0 = performance.now();
            function tick(now) {
                var p = Math.min((now - t0) / duration, 1);
                var ease = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(start + (target - start) * ease);
                if (p < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        }
        
        function fmtDate(s) {
            if (!s) return '';
            try {
                return new Date(s).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' });
            } catch(e) { return s; }
        }
        
        function classifyItem(title) {
            var t = title.toLowerCase();
            if (t.includes('robot') || t.includes('humanoid') || t.includes('loco') || t.includes('manipulation')) return 'robot';
            if (t.includes('multi-agent') || t.includes('multiagent') || t.includes('collective') || t.includes('swarm')) return 'agent';
            if (t.includes('align') || t.includes('safety') || t.includes('ethic') || t.includes('govern')) return 'alignment';
            if (t.includes('llm') || t.includes('language model') || t.includes('gpt') || t.includes('transformer')) return 'llm';
            return 'default';
        }
        
        function loadStats() {
            api('/stats').then(function(d) {
                if (!d) return;
                animateNum(document.getElementById('stat-total'), d.total_items || 0);
                animateNum(document.getElementById('stat-artigos'), d.total_artigos || 0);
                animateNum(document.getElementById('stat-grants'), d.total_grants || 0);
            });
        }
        
        function renderItems(items) {
            var el = document.getElementById('content');
            if (!items || items.length === 0) {
                el.innerHTML = '<div class="empty"><div class="empty-icon">📭</div><div class="empty-text">Nenhum item encontrado</div></div>';
                return;
            }
            el.innerHTML = items.map(function(item, i) {
                var badge = classifyItem(item.title);
                var badgeLabels = {robot: '🤖 Robótica', llm: '🧠 LLM', agent: '🤝 Multi-Agent', alignment: '⚖️ Alignment', default: '📄 Artigo'};
                var delay = Math.min(i * 50, 200);
                return '<div class="card" style="animation-delay:' + delay + 'ms">' +
                    '<div class="card-header">' +
                        '<span class="card-badge ' + badge + '">' + badgeLabels[badge] + '</span>' +
                        '<div class="card-title">' + item.title + '</div>' +
                    '</div>' +
                    '<div class="card-meta"><span>📌 ' + item.source + '</span><span>📅 ' + fmtDate(item.scraped_at) + '</span></div>' +
                    (item.snippet ? '<div class="card-snippet">' + item.snippet + '</div>' : '') +
                    '<div class="card-actions">' +
                        '<a href="' + item.url + '" target="_blank" class="btn btn-primary">🔗 Abrir</a>' +
                        '<button class="btn btn-secondary btn-icon" onclick="feedback(\'' + item.hash + '\', 1)">👍</button>' +
                        '<button class="btn btn-secondary btn-icon" onclick="feedback(\'' + item.hash + '\', 0)">👎</button>' +
                    '</div>' +
                '</div>';
            }).join('');
        }
        
        function loadItems(filter) {
            filter = filter || 'all';
            var el = document.getElementById('content');
            el.innerHTML = '<div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div>';
            api('/items?type=all').then(function(d) {
                if (!d) return;
                allItems = d.items || [];
                var filtered = filter === 'all' ? allItems : allItems.filter(function(item) {
                    return classifyItem(item.title) === filter;
                });
                renderItems(filtered);
            });
        }
        
        function feedback(hash, label) {
            haptic('light');
            api('/feedback', { method: 'POST', body: JSON.stringify({ hash: hash, label: label }) });
            showToast(label ? '👍 Feedback: Útil!' : '👎 Feedback: Não útil');
        }
        
        function showToast(msg) {
            var t = document.getElementById('toast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(function() { t.classList.remove('show'); }, 2000);
        }
        
        function setFilter(filter) {
            haptic('medium');
            currentFilter = filter;
            document.querySelectorAll('.chip').forEach(function(c) {
                c.classList.toggle('active', c.dataset.filter === filter);
            });
            loadItems(filter);
        }
        
        function toggleSettings() {
            haptic('medium');
            showToast('Configurações em breve');
        }
        
        document.querySelectorAll('.chip').forEach(function(c) {
            c.addEventListener('click', function() { setFilter(c.dataset.filter); });
        });
        
        loadStats();
        loadItems('all');
    </script>
</body>
</html>
