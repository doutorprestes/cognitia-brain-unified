<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
    <meta name="theme-color" content="#0a0f1d">
    <title>CognitiaBrain</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        :root {
            --bg: var(--tg-theme-bg-color, #0a0f1d);
            --surface: var(--tg-theme-secondary-bg-color, #131a2b);
            --surface-hover: var(--tg-theme-section-bg-color, #1a2332);
            --primary: var(--tg-theme-button-color, #3b82f6);
            --primary-text: var(--tg-theme-button-text-color, #ffffff);
            --text: var(--tg-theme-text-color, #f0f4f8);
            --text-muted: var(--tg-theme-hint-color, #8892a4);
            --link: var(--tg-theme-link-color, #60a5fa);
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            --radius: 14px;
            --radius-sm: 10px;
            --radius-lg: 20px;
            --space: 14px;
            
            /* Cores por categoria */
            --cat-robot: #10b981;
            --cat-llm: #3b82f6;
            --cat-agent: #a855f7;
            --cat-alignment: #f59e0b;
            --cat-default: #64748b;
        }
        
        html, body { height: 100%; }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            background: var(--bg);
            color: var(--text);
            font-size: 15px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        
        .app {
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: linear-gradient(180deg, var(--bg) 0%, #080c16 100%);
        }
        
        /* Header */
        .header {
            flex-shrink: 0;
            padding: 14px 16px;
            padding-top: calc(14px + var(--safe-top));
            background: var(--surface);
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        
        .header-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .brand-icon {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-sm);
            background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            box-shadow: 0 4px 12px rgba(59,130,246,0.3);
        }
        
        .brand-text h1 {
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.2;
        }
        
        .brand-text p {
            font-size: 0.65rem;
            color: var(--text-muted);
            font-weight: 500;
        }
        
        .header-actions {
            display: flex;
            gap: 8px;
        }
        
        .icon-btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.06);
            background: rgba(255,255,255,0.03);
            color: var(--text-muted);
            font-size: 0.9rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s;
        }
        
        .icon-btn:active {
            background: rgba(255,255,255,0.08);
            transform: scale(0.95);
        }
        
        /* Stats */
        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            padding: var(--space) 16px;
            flex-shrink: 0;
        }
        
        .stat {
            background: var(--surface);
            border-radius: var(--radius-sm);
            padding: 12px 10px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.04);
            position: relative;
            overflow: hidden;
        }
        
        .stat::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--primary);
            opacity: 0.6;
        }
        
        .stat:nth-child(1)::before { background: linear-gradient(90deg, #3b82f6, #8b5cf6); }
        .stat:nth-child(2)::before { background: linear-gradient(90deg, #10b981, #3b82f6); }
        .stat:nth-child(3)::before { background: linear-gradient(90deg, #f59e0b, #ef4444); opacity: 0.4; }
        
        .stat-value {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text);
            line-height: 1;
            letter-spacing: -0.02em;
        }
        
        .stat-label {
            font-size: 0.6rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-weight: 600;
            margin-top: 4px;
        }
        
        /* Filters */
        .filters {
            display: flex;
            gap: 6px;
            padding: 0 16px var(--space);
            flex-shrink: 0;
        }
        
        .chip {
            flex: 1;
            padding: 10px 8px;
            border-radius: var(--radius-sm);
            border: 1px solid rgba(255,255,255,0.06);
            background: var(--surface);
            color: var(--text-muted);
            font-size: 0.65rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            text-align: center;
            white-space: nowrap;
        }
        
        .chip:active { transform: scale(0.96); }
        
        .chip.active {
            background: var(--primary);
            color: var(--primary-text);
            border-color: var(--primary);
            box-shadow: 0 4px 12px rgba(59,130,246,0.3);
        }
        
        /* Content */
        .content {
            flex: 1;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            padding: 0 16px;
            padding-bottom: calc(20px + var(--safe-bottom));
        }
        
        /* Card */
        .card {
            background: var(--surface);
            border-radius: var(--radius);
            margin-bottom: 10px;
            border: 1px solid rgba(255,255,255,0.04);
            overflow: hidden;
            animation: cardIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
        }
        
        @keyframes cardIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .card-accent {
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--cat-default);
        }
        
        .card[data-cat="robot"] .card-accent { background: var(--cat-robot); }
        .card[data-cat="llm"] .card-accent { background: var(--cat-llm); }
        .card[data-cat="agent"] .card-accent { background: var(--cat-agent); }
        .card[data-cat="alignment"] .card-accent { background: var(--cat-alignment); }
        
        .card-body {
            padding: 14px 14px 14px 18px;
        }
        
        .card-top {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }
        
        .card-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: rgba(100,116,139,0.15);
            color: var(--cat-default);
            flex-shrink: 0;
        }
        
        .card[data-cat="robot"] .card-badge { background: rgba(16,185,129,0.12); color: var(--cat-robot); }
        .card[data-cat="llm"] .card-badge { background: rgba(59,130,246,0.12); color: var(--cat-llm); }
        .card[data-cat="agent"] .card-badge { background: rgba(168,85,247,0.12); color: var(--cat-agent); }
        .card[data-cat="alignment"] .card-badge { background: rgba(245,158,11,0.12); color: var(--cat-alignment); }
        
        .card-date {
            font-size: 0.6rem;
            color: var(--text-muted);
            font-weight: 500;
        }
        
        .card-title {
            font-size: 0.85rem;
            font-weight: 600;
            line-height: 1.4;
            margin-bottom: 6px;
            color: var(--text);
        }
        
        .card-snippet {
            font-size: 0.72rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 12px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        .card-footer {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .source {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 0.65rem;
            color: var(--text-muted);
            font-weight: 500;
        }
        
        .actions {
            display: flex;
            gap: 6px;
        }
        
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            padding: 7px 12px;
            border-radius: var(--radius-sm);
            border: none;
            font-size: 0.65rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s;
            text-decoration: none;
        }
        
        .btn:active { transform: scale(0.95); }
        
        .btn-primary {
            background: var(--primary);
            color: var(--primary-text);
            box-shadow: 0 2px 8px rgba(59,130,246,0.25);
        }
        
        .btn-icon {
            width: 32px;
            height: 32px;
            padding: 0;
            border-radius: 50%;
            font-size: 0.85rem;
            background: rgba(255,255,255,0.05);
            color: var(--text-muted);
            border: 1px solid rgba(255,255,255,0.06);
        }
        
        .btn-icon:active {
            background: rgba(255,255,255,0.1);
        }
        
        /* Empty */
        .empty {
            text-align: center;
            padding: 50px 20px;
        }
        
        .empty-icon { font-size: 2.5rem; margin-bottom: 10px; opacity: 0.3; }
        .empty-text { font-size: 0.8rem; color: var(--text-muted); }
        
        /* Skeleton */
        .skeleton {
            background: linear-gradient(90deg, var(--surface) 25%, var(--surface-hover) 50%, var(--surface) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: var(--radius);
            height: 130px;
            margin-bottom: 10px;
        }
        
        @keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        
        /* Toast */
        .toast {
            position: fixed;
            bottom: calc(20px + var(--safe-bottom));
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--surface);
            border: 1px solid rgba(255,255,255,0.08);
            padding: 10px 20px;
            border-radius: 24px;
            font-size: 0.75rem;
            font-weight: 600;
            z-index: 100;
            opacity: 0;
            transition: all 0.25s;
            pointer-events: none;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>
    <div class="app">
        <header class="header">
            <div class="header-top">
                <div class="brand">
                    <div class="brand-icon">🧠</div>
                    <div class="brand-text">
                        <h1>CognitiaBrain</h1>
                        <p>Monitoramento Acadêmico</p>
                    </div>
                </div>
                <div class="header-actions">
                    <button class="icon-btn" onclick="refresh()">🔄</button>
                    <button class="icon-btn" onclick="toggleSettings()">⚙️</button>
                </div>
            </div>
        </header>
        
        <div class="stats">
            <div class="stat"><div class="stat-value" id="stat-total">0</div><div class="stat-label">Total</div></div>
            <div class="stat"><div class="stat-value" id="stat-artigos">0</div><div class="stat-label">Artigos</div></div>
            <div class="stat"><div class="stat-value" id="stat-grants">0</div><div class="stat-label">Grants</div></div>
        </div>
        
        <div class="filters">
            <button class="chip active" data-filter="all">📋 Todos</button>
            <button class="chip" data-filter="robot">🤖 Robótica</button>
            <button class="chip" data-filter="llm">💬 LLM</button>
            <button class="chip" data-filter="agent">🤝 Multi-Agent</button>
            <button class="chip" data-filter="alignment">⚖️ Alignment</button>
        </div>
        
        <div class="content" id="content">
            <div class="skeleton"></div>
            <div class="skeleton"></div>
            <div class="skeleton"></div>
        </div>
    </div>
    
    <div class="toast" id="toast"></div>
    
    <script>
        var tg = window.Telegram.WebApp;
        tg.ready();
        tg.expand();
        
        var currentFilter = 'all';
        var allItems = [];
        
        function haptic(type) {
            if (tg.HapticFeedback) tg.HapticFeedback.impactOccurred(type || 'light');
        }
        
        function api(endpoint, opts) {
            opts = opts || {};
            return fetch('/api' + endpoint, {
                headers: { 'Content-Type': 'application/json' },
                ...opts
            }).then(function(r) { return r.json(); });
        }
        
        function animateNum(el, target) {
            var start = parseInt(el.textContent) || 0;
            if (start === target) return;
            var duration = 500;
            var t0 = performance.now();
            function tick(now) {
                var p = Math.min((now - t0) / duration, 1);
                var ease = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(start + (target - start) * ease);
                if (p < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        }
        
        function fmtDate(s) {
            if (!s) return '';
            try {
                return new Date(s).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' });
            } catch(e) { return s; }
        }
        
        function classifyItem(title) {
            var t = title.toLowerCase();
            if (t.includes('robot') || t.includes('humanoid') || t.includes('loco') || t.includes('manipulation') || t.includes('swarm')) return 'robot';
            if (t.includes('multi-agent') || t.includes('multiagent') || t.includes('collective') || t.includes('agent-based')) return 'agent';
            if (t.includes('align') || t.includes('safety') || t.includes('ethic') || t.includes('govern') || t.includes('conscious')) return 'alignment';
            if (t.includes('llm') || t.includes('language model') || t.includes('gpt') || t.includes('transformer') || t.includes('bert')) return 'llm';
            return 'default';
        }
        
        function loadStats() {
            api('/stats').then(function(d) {
                if (!d) return;
                animateNum(document.getElementById('stat-total'), d.total_items || 0);
                animateNum(document.getElementById('stat-artigos'), d.total_artigos || 0);
                animateNum(document.getElementById('stat-grants'), d.total_grants || 0);
            });
        }
        
        function renderItems(items) {
            var el = document.getElementById('content');
            if (!items || items.length === 0) {
                el.innerHTML = '<div class="empty"><div class="empty-icon">📭</div><div class="empty-text">Nenhum item encontrado</div></div>';
                return;
            }
            el.innerHTML = items.map(function(item, i) {
                var cat = classifyItem(item.title);
                var badgeLabels = {robot: '🤖 Robótica', llm: '💬 LLM', agent: '🤝 Multi-Agent', alignment: '⚖️ Alignment', default: '📄 Artigo'};
                var delay = Math.min(i * 60, 300);
                return '<div class="card" data-cat="' + cat + '" style="animation-delay:' + delay + 'ms">' +
                    '<div class="card-accent"></div>' +
                    '<div class="card-body">' +
                        '<div class="card-top">' +
                            '<span class="card-badge">' + badgeLabels[cat] + '</span>' +
                            '<span class="card-date">📅 ' + fmtDate(item.scraped_at) + '</span>' +
                        '</div>' +
                        '<div class="card-title">' + item.title + '</div>' +
                        (item.snippet ? '<div class="card-snippet">' + item.snippet + '</div>' : '') +
                        '<div class="card-footer">' +
                            '<span class="source">📌 ' + item.source + '</span>' +
                            '<div class="actions">' +
                                '<a href="' + item.url + '" target="_blank" class="btn btn-primary">🔗 Abrir</a>' +
                                '<button class="btn btn-icon" onclick="feedback(\'' + item.hash + '\', 1)">👍</button>' +
                                '<button class="btn btn-icon" onclick="feedback(\'' + item.hash + '\', 0)">👎</button>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';
            }).join('');
        }
        
        function loadItems(filter) {
            filter = filter || 'all';
            var el = document.getElementById('content');
            el.innerHTML = '<div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>';
            api('/items?type=all').then(function(d) {
                if (!d) return;
                allItems = d.items || [];
                var filtered = filter === 'all' ? allItems : allItems.filter(function(item) {
                    return classifyItem(item.title) === filter;
                });
                renderItems(filtered);
            });
        }
        
        function feedback(hash, label) {
            haptic('light');
            api('/feedback', { method: 'POST', body: JSON.stringify({ hash: hash, label: label }) });
            showToast(label ? '👍 Feedback: Útil!' : '👎 Feedback: Não útil');
        }
        
        function showToast(msg) {
            var t = document.getElementById('toast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(function() { t.classList.remove('show'); }, 2000);
        }
        
        function setFilter(filter) {
            haptic('medium');
            currentFilter = filter;
            document.querySelectorAll('.chip').forEach(function(c) {
                c.classList.toggle('active', c.dataset.filter === filter);
            });
            loadItems(filter);
        }
        
        function refresh() {
            haptic('medium');
            showToast('🔄 Atualizando...');
            loadStats();
            loadItems(currentFilter);
        }
        
        function toggleSettings() {
            haptic('medium');
            showToast('⚙️ Configurações em breve');
        }
        
        document.querySelectorAll('.chip').forEach(function(c) {
            c.addEventListener('click', function() { setFilter(c.dataset.filter); });
        });
        
        loadStats();
        loadItems('all');
    </script>
</body>
</html>
