<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#0f172a">
    <title>CognitiaBrain</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        :root {
            /* Telegram theme params - dinâmico */
            --bg: var(--tg-theme-bg-color, #0f172a);
            --surface: var(--tg-theme-secondary-bg-color, #1e293b);
            --surface-elevated: var(--tg-theme-section-bg-color, #273548);
            --primary: var(--tg-theme-button-color, #3b82f6);
            --primary-text: var(--tg-theme-button-text-color, #ffffff);
            --text: var(--tg-theme-text-color, #f1f5f9);
            --text-muted: var(--tg-theme-hint-color, #94a3b8);
            --link: var(--tg-theme-link-color, #60a5fa);
            --destructive: #ef4444;
            --success: #22c55e;
            
            /* Safe areas */
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            
            /* Spacing */
            --space-xs: 4px;
            --space-sm: 8px;
            --space-md: 12px;
            --space-lg: 16px;
            --space-xl: 24px;
            
            /* Radius */
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 24px;
        }
        
        html, body {
            height: 100%;
            overflow: hidden;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }
        
        /* App container */
        .app {
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        
        /* Header */
        .header {
            flex-shrink: 0;
            padding: var(--space-lg) var(--space-lg) var(--space-md);
            padding-top: calc(var(--space-lg) + var(--safe-top));
            background: var(--surface);
            border-bottom: 1px solid rgba(148,163,184,0.1);
        }
        
        .header-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .header-title {
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }
        
        .header-subtitle {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 2px;
        }
        
        .header-badge {
            background: var(--primary);
            color: var(--primary-text);
            padding: var(--space-xs) var(--space-sm);
            border-radius: var(--radius-xl);
            font-size: 0.65rem;
            font-weight: 700;
        }
        
        /* Stats */
        .stats {
            display: flex;
            gap: var(--space-sm);
            padding: var(--space-md) var(--space-lg);
            flex-shrink: 0;
        }
        
        .stat {
            flex: 1;
            background: var(--surface);
            border-radius: var(--radius-md);
            padding: var(--space-md);
            text-align: center;
            border: 1px solid rgba(148,163,184,0.08);
        }
        
        .stat-value {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--primary);
            line-height: 1;
        }
        
        .stat-label {
            font-size: 0.6rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            margin-top: var(--space-xs);
        }
        
        /* Content */
        .content {
            flex: 1;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            padding: var(--space-md) var(--space-lg);
            padding-bottom: calc(80px + var(--safe-bottom));
        }
        
        /* Filter chips */
        .filters {
            display: flex;
            gap: var(--space-sm);
            margin-bottom: var(--space-md);
            flex-shrink: 0;
        }
        
        .chip {
            padding: var(--space-sm) var(--space-md);
            border-radius: var(--radius-xl);
            border: 1px solid rgba(148,163,184,0.15);
            background: var(--surface);
            color: var(--text-muted);
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
            white-space: nowrap;
        }
        
        .chip.active {
            background: var(--primary);
            color: var(--primary-text);
            border-color: var(--primary);
        }
        
        /* Cards */
        .card {
            background: var(--surface);
            border-radius: var(--radius-lg);
            padding: var(--space-lg);
            margin-bottom: var(--space-md);
            border: 1px solid rgba(148,163,184,0.08);
            animation: cardIn 0.3s ease-out;
        }
        
        @keyframes cardIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .card-header {
            display: flex;
            align-items: flex-start;
            gap: var(--space-sm);
            margin-bottom: var(--space-sm);
        }
        
        .card-type {
            display: inline-flex;
            align-items: center;
            gap: var(--space-xs);
            padding: var(--space-xs) var(--space-sm);
            border-radius: var(--radius-xl);
            font-size: 0.6rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            flex-shrink: 0;
        }
        
        .card-type.grant {
            background: rgba(34,197,94,0.12);
            color: var(--success);
        }
        
        .card-type.artigo {
            background: rgba(59,130,246,0.12);
            color: var(--link);
        }
        
        .card-title {
            font-size: 0.9rem;
            font-weight: 600;
            line-height: 1.4;
            flex: 1;
        }
        
        .card-meta {
            display: flex;
            gap: var(--space-md);
            font-size: 0.7rem;
            color: var(--text-muted);
            margin-bottom: var(--space-sm);
        }
        
        .card-snippet {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: var(--space-md);
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        .card-actions {
            display: flex;
            gap: var(--space-sm);
        }
        
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--space-xs);
            padding: var(--space-sm) var(--space-md);
            border-radius: var(--radius-sm);
            border: none;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
        }
        
        .btn:active { transform: scale(0.96); }
        
        .btn-primary {
            background: var(--primary);
            color: var(--primary-text);
        }
        
        .btn-secondary {
            background: rgba(148,163,184,0.1);
            color: var(--text);
        }
        
        .btn-icon {
            width: 36px;
            height: 36px;
            padding: 0;
            border-radius: 50%;
            font-size: 1rem;
        }
        
        /* Empty state */
        .empty {
            text-align: center;
            padding: var(--space-xl) var(--space-lg);
            color: var(--text-muted);
        }
        
        .empty-icon {
            font-size: 2.5rem;
            margin-bottom: var(--space-md);
            opacity: 0.4;
        }
        
        .empty-text {
            font-size: 0.85rem;
        }
        
        /* Skeleton */
        .skeleton {
            background: linear-gradient(90deg, var(--surface) 25%, var(--surface-elevated) 50%, var(--surface) 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
            border-radius: var(--radius-md);
        }
        
        @keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        
        .skeleton-card {
            height: 140px;
            margin-bottom: var(--space-md);
        }
        
        /* Toast */
        .toast {
            position: fixed;
            bottom: calc(90px + var(--safe-bottom));
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--surface-elevated);
            border: 1px solid rgba(148,163,184,0.15);
            padding: var(--space-md) var(--space-lg);
            border-radius: var(--radius-xl);
            font-size: 0.8rem;
            font-weight: 600;
            z-index: 100;
            opacity: 0;
            transition: all 0.25s ease;
            pointer-events: none;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }
        
        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>
    <div class="app">
        <header class="header">
            <div class="header-top">
                <div>
                    <div class="header-title">CognitiaBrain</div>
                    <div class="header-subtitle">Monitoramento Acadêmico</div>
                </div>
                <div class="header-badge" id="header-badge">AO VIVO</div>
            </div>
        </header>
        
        <div class="stats">
            <div class="stat"><div class="stat-value" id="stat-total">0</div><div class="stat-label">Total</div></div>
            <div class="stat"><div class="stat-value" id="stat-grants">0</div><div class="stat-label">Grants</div></div>
            <div class="stat"><div class="stat-value" id="stat-artigos">0</div><div class="stat-label">Artigos</div></div>
        </div>
        
        <div class="content" id="content">
            <div class="filters">
                <div class="chip active" data-type="all">Todos</div>
                <div class="chip" data-type="grant">Grants</div>
                <div class="chip" data-type="artigo">Artigos</div>
            </div>
            <div id="items">
                <div class="skeleton skeleton-card"></div>
                <div class="skeleton skeleton-card"></div>
                <div class="skeleton skeleton-card"></div>
            </div>
        </div>
    </div>
    
    <div class="toast" id="toast"></div>
    
    <script>
        // Telegram WebApp
        var tg = window.Telegram.WebApp;
        tg.ready();
        tg.expand();
        
        // State
        var currentType = 'all';
        var allItems = [];
        
        // Haptic feedback
        function haptic(type) {
            if (tg.HapticFeedback) {
                tg.HapticFeedback.impactOccurred(type || 'light');
            }
        }
        
        // API
        function api(endpoint, opts) {
            opts = opts || {};
            return fetch('/api' + endpoint, {
                headers: { 'Content-Type': 'application/json' },
                ...opts
            }).then(function(r) { return r.json(); });
        }
        
        // Animate number
        function animateNum(el, target) {
            var start = parseInt(el.textContent) || 0;
            if (start === target) return;
            var duration = 500;
            var t0 = performance.now();
            function tick(now) {
                var p = Math.min((now - t0) / duration, 1);
                var ease = 1 - Math.pow(1 - p, 3);
                el.textContent = Math.round(start + (target - start) * ease);
                if (p < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        }
        
        // Format date
        function fmtDate(s) {
            if (!s) return '';
            try {
                return new Date(s).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' });
            } catch(e) { return s; }
        }
        
        // Load stats
        function loadStats() {
            api('/stats').then(function(d) {
                if (!d) return;
                animateNum(document.getElementById('stat-total'), d.total_items || 0);
                animateNum(document.getElementById('stat-grants'), d.total_grants || 0);
                animateNum(document.getElementById('stat-artigos'), d.total_artigos || 0);
            });
        }
        
        // Render items
        function renderItems(items) {
            var el = document.getElementById('items');
            if (!items || items.length === 0) {
                el.innerHTML = '<div class="empty"><div class="empty-icon">📭</div><div class="empty-text">Nenhum item encontrado</div></div>';
                return;
            }
            el.innerHTML = items.map(function(item, i) {
                var typeClass = item.type || 'artigo';
                var typeLabel = typeClass === 'grant' ? 'Grant' : 'Artigo';
                var delay = Math.min(i * 60, 300);
                return '<div class="card" style="animation-delay:' + delay + 'ms">' +
                    '<div class="card-header">' +
                        '<span class="card-type ' + typeClass + '">' + typeLabel + '</span>' +
                        '<div class="card-title">' + item.title + '</div>' +
                    '</div>' +
                    '<div class="card-meta"><span>📌 ' + item.source + '</span><span>📅 ' + fmtDate(item.scraped_at) + '</span></div>' +
                    (item.snippet ? '<div class="card-snippet">' + item.snippet + '</div>' : '') +
                    '<div class="card-actions">' +
                        '<a href="' + item.url + '" target="_blank" class="btn btn-primary">🔗 Abrir</a>' +
                        '<button class="btn btn-secondary btn-icon" onclick="fb(\'' + item.hash + '\', 1)">👍</button>' +
                        '<button class="btn btn-secondary btn-icon" onclick="fb(\'' + item.hash + '\', 0)">👎</button>' +
                    '</div>' +
                '</div>';
            }).join('');
        }
        
        // Load items
        function loadItems(type) {
            type = type || 'all';
            var el = document.getElementById('items');
            el.innerHTML = '<div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div><div class="skeleton skeleton-card"></div>';
            api('/items?type=' + type).then(function(d) {
                if (!d) return;
                allItems = d.items || [];
                renderItems(allItems);
            });
        }
        
        // Feedback
        function fb(hash, label) {
            haptic('light');
            api('/feedback', { method: 'POST', body: JSON.stringify({ hash: hash, label: label }) });
            showToast(label ? '👍 Útil!' : '👎 Não útil');
        }
        
        // Toast
        function showToast(msg) {
            var t = document.getElementById('toast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(function() { t.classList.remove('show'); }, 2000);
        }
        
        // Filter
        function setFilter(type) {
            haptic('medium');
            currentType = type;
            document.querySelectorAll('.chip').forEach(function(c) {
                c.classList.toggle('active', c.dataset.type === type);
            });
            loadItems(type);
        }
        
        // Events
        document.querySelectorAll('.chip').forEach(function(c) {
            c.addEventListener('click', function() { setFilter(c.dataset.type); });
        });
        
        // Init
        loadStats();
        loadItems('all');
    </script>
</body>
</html>
